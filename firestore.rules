rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All Unspecified Paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document - Strict Path-Bound Authorization
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid;
      allow delete: if false;

      // User-Owned Journals Subcollection
      match /journals/{journalId} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidId(journalId)
          && request.resource.data.userId == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.initialPrompt is string
          && request.resource.data.initialPrompt.size() <= 10000
          && request.resource.data.latestResponse is string
          && request.resource.data.latestResponse.size() <= 30000
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && isValidId(journalId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid) && isValidId(journalId);

        // Dialogue Turns Subcollection
        match /messages/{messageId} {
          allow get, list: if isOwner(uid);
          allow create: if isOwner(uid)
            && isValidId(messageId)
            && request.resource.data.role in ['user', 'model']
            && request.resource.data.content is string
            && request.resource.data.content.size() <= 30000
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false; // Messages are immutable history
        }
      }
    }
  }
}
